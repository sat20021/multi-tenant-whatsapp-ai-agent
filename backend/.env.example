NODE_ENV=development
PORT=4000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/whatsapp_ai_agent

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# AI Service
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=25000

# WhatsApp mode: "mock" saves to DB instead of calling Meta, "real" calls Meta Graph API
WHATSAPP_MODE=mock
WHATSAPP_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_VERIFY_TOKEN=digitalonebox_verify_token

# Worker
WORKER_CONCURRENCY=20
JOB_ATTEMPTS=3
JOB_BACKOFF_DELAY=2000

# Dev simulation
WEBHOOK_URL=http://localhost:4000/webhook/whatsapp
