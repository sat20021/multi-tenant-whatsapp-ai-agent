NODE_ENV=development
PORT=4000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/whatsapp_ai_agent

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# AI Service (Python FastAPI)
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=25000

# WhatsApp Mode: 'mock' or 'real'
WHATSAPP_MODE=mock
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=digitalonebox_verify_token

# BullMQ Worker Configuration
WORKER_CONCURRENCY=20
JOB_ATTEMPTS=3
JOB_BACKOFF_DELAY=2000

# Webhook URL for simulation script
WEBHOOK_URL=http://localhost:4000/webhook/whatsapp
